# =====================================================================
# LexiVance IELTS — Environment Variables Configuration
# =====================================================================

# 1. Supabase Project URL (From Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous / Public API Key (From Project Settings > API)
# Safe to expose in the browser, protected by PostgreSQL Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Supabase Service Role Key (RESTRICTED: Never expose in the browser)
# Used only in server-side API routes and administrative setup scripts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 4. Optional Next.js Public App URL (Default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
